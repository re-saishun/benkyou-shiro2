# Third-party integration secrets (configured in Google AI Studio Secrets panel or local .env).
# Never put GEMINI_API_KEY here; Gemini AI runs via Firebase AI Logic + App Check.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
GITHUB_GRAMMAR_CATALOG_URL=your_github_grammar_catalog_url_here
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_github_repo_slug_here
